{
  "name": "@microlab/circuit-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MicroLab circuit schema: single source of truth for the circuit document format and component definitions.",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*",
    "./definitions/*": "./definitions/*",
    "./examples/*": "./examples/*"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3"
  }
}
