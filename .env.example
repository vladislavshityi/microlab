# MicroLab — пример конфигурации для локальной разработки.
# Использование: cp .env.example .env  (файл .env не коммитится).
# Пароль "microlab" — только для локальной dev-БД из docker-compose.yml, не секрет.

# development | test | production
MICROLAB_ENV=development

# DSN для API и Alembic (драйвер asyncpg). Порт совпадает с MICROLAB_POSTGRES_PORT.
MICROLAB_DATABASE_URL=postgresql+asyncpg://microlab:microlab@127.0.0.1:5433/microlab

# DEBUG | INFO | WARNING | ERROR | CRITICAL
MICROLAB_LOG_LEVEL=INFO

# json | console
MICROLAB_LOG_FORMAT=json

# Порт PostgreSQL на хосте (используется docker-compose.yml).
MICROLAB_POSTGRES_PORT=5433

# Воркер компиляции (docker compose: сервис compiler за dev-шлюзом compiler-gateway).
MICROLAB_COMPILER_URL=http://127.0.0.1:8081

# Порт dev-шлюза воркера компиляции на хосте (используется docker-compose.yml).
MICROLAB_COMPILER_PORT=8081

# Сервис симуляции (docker compose: сервис simulator за dev-шлюзом simulator-gateway, WebSocket /sessions).
MICROLAB_SIMULATOR_URL=ws://127.0.0.1:8082

# Порт dev-шлюза сервиса симуляции на хосте (используется docker-compose.yml).
MICROLAB_SIMULATOR_PORT=8082
