# MicroLab — пример конфигурации.
# Использование: cp .env.example .env  (файл .env не коммитится).
# Значения подходят для локального запуска. На сервере обязательно замените
# MICROLAB_POSTGRES_PASSWORD (см. README, «Развёртывание на сервере»).

# development | test | production
# На сервере — production (первый администратор: README, «Пользователи и доступ»).
MICROLAB_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
MICROLAB_LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose.yml) ---

# Пароль пользователя microlab. Применяется только при создании пустого volume.
# Только символы, допустимые в URL без экранирования (например: openssl rand -hex 24).
MICROLAB_POSTGRES_PASSWORD=microlab

# --- Полный стек в Docker (docker-compose.yml) ---

# Адрес и порт nginx на хосте: http://localhost:8080.
# 127.0.0.1 — только с этого компьютера; 0.0.0.0 — из сети (только вместе с защитой доступа).
MICROLAB_HTTP_BIND=127.0.0.1
MICROLAB_HTTP_PORT=8080

# Подсеть внутренней сети nginx ↔ API (API доверяет X-Forwarded-* только из неё).
# Меняйте, только если она пересекается с существующими сетями.
MICROLAB_EDGE_SUBNET=10.253.83.0/29

# Сервер: каталог с fullchain.pem/privkey.pem (docker-compose.tls.yml)
# и файл htpasswd (docker-compose.auth.yml).
# MICROLAB_TLS_DIR=/etc/microlab/tls
# MICROLAB_HTPASSWD_FILE=/etc/microlab/htpasswd

# --- Разработка: API (uv) и Vite на хосте ---

# Раскомментируйте, чтобы docker compose всегда подключал dev-дополнение
# (PostgreSQL на 127.0.0.1 и dev-шлюзы воркеров).
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# json | console (API на хосте; в контейнере всегда json)
MICROLAB_LOG_FORMAT=json

# DSN для API и Alembic на хосте. Пароль совпадает с MICROLAB_POSTGRES_PASSWORD,
# порт — с MICROLAB_POSTGRES_PORT.
MICROLAB_DATABASE_URL=postgresql+asyncpg://microlab:microlab@127.0.0.1:5433/microlab

# Порты dev-дополнения на 127.0.0.1 (docker-compose.dev.yml).
MICROLAB_POSTGRES_PORT=5433
MICROLAB_COMPILER_PORT=8081
MICROLAB_SIMULATOR_PORT=8082

# Воркер компиляции и сервис симуляции через dev-шлюз (dev-gateway).
MICROLAB_COMPILER_URL=http://127.0.0.1:8081
MICROLAB_SIMULATOR_URL=ws://127.0.0.1:8082
